{
  "name": "astroviewcms",
  "private": true,
  "type": "module",
  "workspaces": [
    "preview-protocol",
    "preview-contract",
    "preview-render-server",
    "cms-server",
    "sample-site"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@swc/core": "1.16.21",
    "dependency-cruiser": "18.7.2",
    "knip": "6.44.1"
  },
  "overrides": {
    "qs": "~6.16.2",
    "postcss-selector-parser": "~6.1.5"
  },
  "scripts": {
    "check": "node scripts/check.ts",
    "preinstall": "node scripts/worktree.ts guard",
    "worktree": "node scripts/worktree.ts",
    "audit": "osv-scanner scan source -L package-lock.json --config osv-scanner.toml",
    "knip": "knip",
    "coverage": "vitest run --coverage",
    "depcruise": "depcruise preview-render-server/src preview-protocol/src preview-contract/src cms-server/src --config .dependency-cruiser.cjs",
    "lint": "biome lint",
    "format:check": "biome format",
    "graph": "node scripts/graph.ts",
    "measure:memory": "node scripts/measure-memory.mjs",
    "measure:listing": "node scripts/measure-listing-routes.mjs",
    "deps": "depcruise preview-render-server/src preview-protocol/src preview-contract/src cms-server/src --config .dependency-cruiser-graph.cjs -T text"
  }
}
