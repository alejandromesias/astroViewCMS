---
// Test editor: one JSON textbox for the whole overlay (interim, task 1.7
// brings a form per document) next to the site in an iframe. The logic is in
// editor.ts. Served by the preview server for convenience (same
// origin as the site); any other editor that speaks src/protocol.ts can
// replace it. Open /__editor?page=/some/path to edit another page (default "/").
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Preview editor</title>
  </head>
  <body>
    <aside>
      <header>
        <h1>Preview editor</h1>
        <p id="status" role="status">Waiting for the page…</p>
      </header>

      <div id="regions"></div>

      <section class="upload">
        <h2>Draft image</h2>
        <input id="upload" type="file" accept="image/png,image/jpeg,image/webp,image/avif,image/gif" />
        <p id="upload-result" hidden>
          <code id="upload-url"></code>
          <button id="upload-copy" type="button">Copy</button>
        </p>
        <p class="hint">Paste the entry under <code>"media"</code> with the image reference as its key.</p>
      </section>
    </aside>

    <iframe id="preview" title="Site preview"></iframe>

    <template id="region-template">
      <section class="region">
        <h2></h2>
        <textarea spellcheck="false" autocomplete="off"></textarea>
        <div class="actions">
          <button type="button" data-action="reset">Reset</button>
          <span class="error" role="alert"></span>
        </div>
      </section>
    </template>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }
  html,
  body {
    height: 100%;
    margin: 0;
  }
  body {
    display: grid;
    grid-template-columns: minmax(320px, 36%) 1fr;
    font: 14px/1.4 system-ui, sans-serif;
    color: #1d2330;
    background: #f3f4f6;
  }
  aside {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 16px;
    overflow: auto;
    border-right: 1px solid #d5d9e0;
  }
  h1 {
    margin: 0;
    font-size: 16px;
  }
  h2 {
    margin: 0 0 6px;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #4b5563;
  }
  #status {
    margin: 4px 0 0;
    color: #4b5563;
  }
  #status[data-state="error"] {
    color: #b42318;
  }
  textarea {
    width: 100%;
    min-height: 50vh;
    padding: 10px;
    font: 12px/1.5 ui-monospace, Consolas, monospace;
    border: 1px solid #c3c9d3;
    border-radius: 6px;
    resize: vertical;
    tab-size: 2;
  }
  textarea[aria-invalid="true"] {
    border-color: #b42318;
    outline-color: #b42318;
  }
  .actions {
    display: flex;
    gap: 12px;
    align-items: center;
    margin-top: 6px;
  }
  .error {
    color: #b42318;
    font-size: 12px;
  }
  .hint {
    margin: 6px 0 0;
    color: #6b7280;
    font-size: 12px;
  }
  #upload-result {
    display: flex;
    gap: 8px;
    align-items: center;
    margin: 8px 0 0;
  }
  code {
    font-size: 12px;
    word-break: break-all;
  }
  iframe {
    width: 100%;
    height: 100%;
    border: 0;
    background: #fff;
  }
</style>

<script>
  import { startEditor } from "./editor.ts";

  startEditor();
</script>
