{
  "name": "preview-render-server",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "node src/build.ts sites/sampleAstroProject.config.ts",
    "start": "node src/start.ts sites/sampleAstroProject.config.ts",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "build:sample": "node src/build.ts sites/sample-site.config.ts",
    "start:sample": "node src/start.ts sites/sample-site.config.ts"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "astro": "^7.3.1",
    "devalue": "^6.0.3",
    "es-module-lexer": "^3.0.4",
    "idiomorph": "^0.8.0",
    "preview-protocol": "*",
    "rolldown": "^1.2.15",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
