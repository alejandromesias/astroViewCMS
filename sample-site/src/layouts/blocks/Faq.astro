---
import { markdownify } from "@/lib/utils/textConverter";

const { block } = Astro.props;
---

<section class="section">
  <div class="container">
    <h2 class="text-center font-normal" set:html={markdownify(block.title)} />
    <div class="section row -mt-6">
      {
        block.items.map((item) => (
          <div class="col-12 mt-6 md:col-6">
            <div class="p-12 shadow">
              <div class="faq-head relative">
                <h4 set:html={markdownify(item.question)} />
              </div>
              <p class="faq-body mt-4" set:html={markdownify(item.answer)} />
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
